{
	"info": {
		"_postman_id": "subastasapp-tpo",
		"name": "SubastasApp API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "http://localhost:8080/auth/login" }
					}
				}
			]
		},
		{
			"name": "Auctions",
			"item": [
				{
					"name": "Get Active Auctions",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "http://localhost:8080/auctions" }
					}
				},
				{
					"name": "Place Bid",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"itemId\": 1,\n    \"monto\": 16000.0\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "http://localhost:8080/auctions/1/bid" }
					}
				}
			]
		}
	]
}
