# Copiá este archivo a .env (está en .gitignore) y completá los valores.
# Nunca subas .env al repositorio.

# --- Base de datos ---
DB_USER=postgres
DB_PASSWORD=cambiame

# --- Backend ---
# Generar con:  openssl rand -base64 48   (mínimo 32 caracteres; no hay valor por defecto)
JWT_SECRET=
# Emails (separados por coma) que pueden aprobar/rechazar consignaciones
ADMIN_EMAILS=admin@demo.local
# Solo desarrollo: imprime en el log el código de recuperación de contraseña
LOG_RESET_CODES=false
